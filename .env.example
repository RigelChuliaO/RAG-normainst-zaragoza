# Copy this file to .env and fill in real values. Never commit .env.

# OpenAI-compatible endpoint. Ollama by default; Azure OpenAI by changing the base URL.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=

# Embedding model (sentence-transformers name), chosen with the evaluation in Phase 1-2
EMBEDDING_MODEL=
